specs (
  { name cirq
    include (docs/cirq-spec/**/*.md)
    impls ({
      name rust
      include (
        cirq-grammar/grammar.js
        cirq-ast/src/**/*.rs
        cirq-ir/src/**/*.rs
        cirq-frontend/src/**/*.rs
        cirq-spice-import/src/**/*.rs
        thevenin-cirq/src/**/*.rs
      )
      test_include (
        cirq-frontend/tests/**/*.rs
        cirq-spice-import/tests/**/*.rs
        thevenin-cirq/tests/**/*.rs
      )
    })
  }
)
